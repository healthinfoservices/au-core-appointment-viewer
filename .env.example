# Copy to .env and set the FHIR R4 base URL of the server holding your
# AU Core resources (no trailing slash needed). It can also be changed
# in the app's Settings dialog; that value is saved in the browser.
#
# Example only — replace with the public test server you actually used:
# VITE_FHIR_BASE_URL=https://hapi.fhir.org/baseR4
VITE_FHIR_BASE_URL=
